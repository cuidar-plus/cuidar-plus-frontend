# Configuração git-secrets para Cuidar+
# Este arquivo define padrões para prevenir commits acidentais de segredos

# Patterns para detectar chaves e tokens
SECRET_KEY\s*=\s*['"][^'"]+['"]
API_KEY\s*=\s*['"][^'"]+['"]
ACCESS_TOKEN\s*=\s*['"][^'"]+['"]
PRIVATE_KEY\s*=\s*['"][^'"]+['"]
DATABASE_URL\s*=\s*['"][^'"]+['"]
OAUTH2.*SECRET\s*=\s*['"][^'"]+['"]

# Patterns para AWS
AKIA[0-9A-Z]{16}
aws_access_key_id\s*=\s*['"][^'"]+['"]
aws_secret_access_key\s*=\s*['"][^'"]+['"]

# Patterns para JWT tokens (formato básico)
eyJ[A-Za-z0-9-_=]+\.[A-Za-z0-9-_=]+\.?[A-Za-z0-9-_.+/=]*

# Patterns para senhas em URLs
://[^:/@]+:[^:/@]+@

# Extensões de arquivos sensíveis
\.pem$
\.p12$
\.key$
\.keystore$

# Arquivos de ambiente
\.env$
\.env\.local$
\.env\.production$
\.env\.staging$

# Permitir arquivos exemplo
!\.env\.example$
!\.env\.template$